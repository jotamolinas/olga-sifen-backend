# Puerto de la aplicación
PORT=3000
NODE_ENV=development

# Feature Flag para habilitar o deshabilitar las rutas de facturación SIFEN
# true = Habilitado | false = Deshabilitado (bloquea peticiones con HTTP 403)
ENABLE_SIFEN_MODULE=true

# Clave secreta para cifrado AES-256 (Debe tener exactamente 32 caracteres o 64 caracteres en hexadecimal)
# Puedes generar una segura con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_SECRET_KEY=e4d2a1b9c8f7e6d5c4b3a291807f6e5d4c3b2a1908f7e6d5c4b3a291807f6e5d

# Configuración SIFEN (Paraguay - DNIT / SET)
SIFEN_ENV=test
SIFEN_URL_TEST=https://sifen-test.set.gov.py/de/ws/consultas/consulta-ruc.wsdl
SIFEN_URL_PROD=https://sifen.set.gov.py/de/ws/consultas/consulta-ruc.wsdl

# Configuración del Certificado Digital de Prueba (.p12 / .pfx)
CERT_P12_PATH=./certs/certificado.p12
CERT_PASSWORD=test1234
CERT_P12_PASSWORD=test1234
