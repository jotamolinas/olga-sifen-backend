{
  "name": "sifen-microservice",
  "version": "1.0.0",
  "description": "Microservicio backend para facturación electrónica SIFEN (Paraguay)",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "patch-package",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "demo:cert": "tsx src/examples/demoCertificado.ts",
    "test:cert": "node test-certificados.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "facturacionelectronicapy-qrgen": "^1.0.0",
    "facturacionelectronicapy-setapi": "^1.0.0",
    "facturacionelectronicapy-xmlgen": "^1.0.0",
    "facturacionelectronicapy-xmlsign": "^1.0.0",
    "fast-xml-parser": "^4.5.1",
    "patch-package": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "node-forge": "0.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
